{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/SOUL.md\"",
            "timeout": 5,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/SOUL.md\"",
            "timeout": 5,
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
